---
import type { GetStaticPaths } from 'astro';
import DetailPage from '../../../components/DetailPage.astro';
import { getCollectionSlugs, getLocalizedEntry } from '../../../i18n/utils';

export const getStaticPaths = (async () => {
  const slugs = await getCollectionSlugs('projects');
  return slugs.map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const entry = await getLocalizedEntry('projects', slug!, 'en');
if (!entry) return Astro.rewrite('/404');
---

<DetailPage entry={entry} collection="projects" lang="en" />
