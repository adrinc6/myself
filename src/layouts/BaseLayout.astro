---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { site, hero } from '../config';
import { localizedPath, useTranslations, defaultLang, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  /** Current route without base or language prefix, for the lang switcher. */
  route: string;
}
const { title, description, lang, route } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title === site.name ? title : `${title} · ${site.shortName}`;
const pageDescription = description ?? hero[lang].seoDescription;

const canonical = new URL(localizedPath(route, lang), Astro.site).href;
const altEs = new URL(localizedPath(route, 'es'), Astro.site).href;
const altEn = new URL(localizedPath(route, 'en'), Astro.site).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0a0a0b" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>

  <body class="flex min-h-full flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-surface-raised focus:px-3 focus:py-2 focus:text-sm focus:text-zinc-100"
    >
      {t('a11y.skip')}
    </a>

    <Nav lang={lang} route={route} />

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:px-6 sm:py-14">
      <slot />
    </main>

    <footer class="border-t border-edge/70">
      <div
        class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-6 text-xs text-zinc-500 sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <p>© {year} {site.name}</p>
        <p>
          {t('footer.builtWith')}{' '}
          <a
            href={site.repo}
            class="text-zinc-400 underline underline-offset-2 transition hover:text-accent"
            rel="noopener noreferrer"
            target="_blank">{t('footer.source')}</a
          >
        </p>
      </div>
    </footer>
  </body>
</html>
