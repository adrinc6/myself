---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { entrySlug, localizedPath, type Lang } from '../i18n/utils';

/**
 * A skill or project as a wide, short row: title, one-line description and a
 * few tech chips. Rows stack vertically, one per line, so a long list stays
 * scannable.
 *
 * Used for the home page previews, which link straight through. The index page
 * uses EntryRow instead, which folds open to show the related items.
 */
interface Props {
  entry: CollectionEntry<'skills'> | CollectionEntry<'projects'>;
  lang: Lang;
  /** Overrides the muted line beside the title. Projects pass their own. */
  meta?: string;
}
const { entry, lang, meta } = Astro.props;
const slug = entrySlug(entry);
const { title, summary, tech } = entry.data;

const collection = 'sector' in entry.data ? 'projects' : 'skills';
// Skills show their category; projects show "sector · period · status".
const metaLine = meta ?? ('category' in entry.data ? entry.data.category : undefined);

// Kept short so the row never grows to two lines of chips.
const shownTech = tech.slice(0, 3);
const extraTech = tech.length - shownTech.length;
---

<a
  href={localizedPath(`${collection}/${slug}`, lang)}
  class="group flex items-center gap-4 rounded-xl border border-edge bg-surface px-4 py-3 transition duration-200 hover:border-edge-strong hover:bg-surface-raised focus-visible:border-accent"
>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5">
      <h3 class="text-sm font-semibold text-zinc-50 transition group-hover:text-accent">
        {title}
      </h3>
      {metaLine && <span class="text-xs text-zinc-500">{metaLine}</span>}
    </div>
    <p class="mt-1 line-clamp-1 text-sm text-zinc-400">{summary}</p>
  </div>

  {
    shownTech.length > 0 && (
      <div class="hidden shrink-0 gap-1.5 sm:flex">
        {shownTech.map((item) => (
          <Tag>{item}</Tag>
        ))}
        {extraTech > 0 && <Tag variant="muted">+{extraTech}</Tag>}
      </div>
    )
  }

  <span
    class="shrink-0 text-zinc-600 transition group-hover:translate-x-0.5 group-hover:text-accent"
    aria-hidden="true">→</span
  >
</a>
