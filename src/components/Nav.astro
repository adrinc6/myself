---
import LangSwitcher from './LangSwitcher.astro';
import { localizedPath, useTranslations, type Lang } from '../i18n/utils';
import { site } from '../config';

interface Props {
  lang: Lang;
  route: string;
}
const { lang, route } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: 'skills', label: t('nav.skills') },
  { href: 'education', label: t('nav.education') },
  { href: 'experience', label: t('nav.experience') },
];
---

<header
  class="sticky top-0 z-50 border-b border-edge/70 bg-page/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex max-w-5xl items-center justify-between gap-3 px-4 py-3 sm:px-6"
    aria-label={t('nav.home')}
  >
    <a
      href={localizedPath('', lang)}
      class="shrink-0 text-sm font-semibold tracking-tight text-zinc-100 transition hover:text-accent"
    >
      {site.shortName}
    </a>

    <div class="flex min-w-0 items-center gap-0.5 sm:gap-2">
      {
        links.map((link) => (
          <a
            href={localizedPath(link.href, lang)}
            class="rounded-lg px-1.5 py-1 text-sm whitespace-nowrap text-zinc-400 transition hover:bg-surface hover:text-zinc-100 sm:px-2"
          >
            {link.label}
          </a>
        ))
      }
      <span class="mx-1 hidden h-4 w-px bg-edge sm:block" aria-hidden="true"></span>
      <LangSwitcher lang={lang} route={route} />
    </div>
  </nav>
</header>
