---
import LangSwitcher from './LangSwitcher.astro';
import { localizedPath, useTranslations, type Lang } from '../i18n/utils';
import { site } from '../config';

interface Props {
  lang: Lang;
  route: string;
}
const { lang, route } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: 'skills', label: t('nav.skills') },
  { href: 'education', label: t('nav.education') },
  { href: 'experience', label: t('nav.experience') },
];
---

<header
  class="sticky top-0 z-50 border-b border-edge/70 bg-page/80 backdrop-blur-md"
>
  <!--
    On a narrow phone the name, the three section links and the language
    switcher do not fit on one line in Spanish, so the links drop to a second
    row instead of being clipped. From `sm` up it is a single row again.
  -->
  <nav
    class="site-container flex flex-wrap items-center gap-x-3 gap-y-1 py-2 sm:flex-nowrap sm:py-3"
    aria-label={t('nav.home')}
  >
    <a
      href={localizedPath('', lang)}
      class="order-1 mr-auto shrink-0 text-[13px] font-semibold tracking-tight text-zinc-100 transition hover:text-accent sm:text-sm"
    >
      {site.shortName}
    </a>

    <div
      class="order-3 -ml-1 flex w-full min-w-0 items-center gap-0.5 sm:order-2 sm:ml-0 sm:w-auto sm:gap-2"
    >
      {
        links.map((link) => (
          <a
            href={localizedPath(link.href, lang)}
            class="rounded-lg px-1 py-1 text-[13px] whitespace-nowrap text-zinc-400 transition hover:bg-surface hover:text-zinc-100 sm:px-2 sm:text-sm"
          >
            {link.label}
          </a>
        ))
      }
      <span class="mx-1 hidden h-4 w-px bg-edge sm:block" aria-hidden="true"></span>
    </div>

    <div class="order-2 shrink-0 sm:order-3">
      <LangSwitcher lang={lang} route={route} />
    </div>
  </nav>
</header>
