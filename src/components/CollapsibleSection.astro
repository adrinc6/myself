---
/**
 * A section panel that can be folded away, so the visitor can skip past a long
 * skills list and reach education and experience sooner.
 *
 * Built on <details>/<summary>: it works with no JavaScript at all, and keyboard
 * and screen-reader support come for free. The small inline script only adds
 * remembering the state between visits.
 */
interface Props {
  title: string;
  description?: string;
  id?: string;
  /** Accessible labels for the toggle button, per state. */
  collapseLabel: string;
  expandLabel: string;
  /** Persisted under this key in localStorage. */
  storageKey?: string;
  class?: string;
}
const {
  title,
  description,
  id,
  collapseLabel,
  expandLabel,
  storageKey,
  class: className,
} = Astro.props;
---

<details
  open
  id={id}
  data-collapsible
  data-storage-key={storageKey}
  class:list={[
    'group/details rounded-2xl border border-edge bg-surface/60 p-5 backdrop-blur-sm sm:p-7',
    className,
  ]}
>
  <summary
    class="flex cursor-pointer list-none items-start justify-between gap-4 [&::-webkit-details-marker]:hidden"
  >
    <div>
      <h2 class="text-xl font-semibold tracking-tight text-zinc-50 sm:text-2xl">
        {title}
      </h2>
      {description && <p class="mt-1 text-sm text-zinc-400">{description}</p>}
    </div>

    <span
      class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-edge text-zinc-400 transition group-hover/details:border-edge-strong group-hover/details:text-zinc-100"
      data-toggle-label
      data-collapse-label={collapseLabel}
      data-expand-label={expandLabel}
      title={collapseLabel}
      aria-label={collapseLabel}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-4 w-4 transition-transform duration-200 group-open/details:rotate-180"
        aria-hidden="true"
      >
        <path d="M5 8l5 5 5-5" />
      </svg>
    </span>
  </summary>

  <div class="mt-5">
    <slot />
  </div>
</details>

<script>
  // Remember the open/closed state per section, and keep the button's
  // label in sync with the current state.
  for (const el of document.querySelectorAll<HTMLDetailsElement>('[data-collapsible]')) {
    const key = el.dataset.storageKey;
    const label = el.querySelector<HTMLElement>('[data-toggle-label]');

    if (key) {
      try {
        const stored = localStorage.getItem(key);
        if (stored !== null) el.open = stored === 'open';
      } catch {
        // Private windows and blocked site data throw; the default state is fine.
      }
    }

    const syncLabel = () => {
      if (!label) return;
      const text = el.open
        ? label.dataset.collapseLabel
        : label.dataset.expandLabel;
      if (!text) return;
      label.setAttribute('aria-label', text);
      label.setAttribute('title', text);
    };

    syncLabel();

    el.addEventListener('toggle', () => {
      syncLabel();
      if (!key) return;
      try {
        localStorage.setItem(key, el.open ? 'open' : 'closed');
      } catch {
        // Not being able to persist is not worth breaking the page over.
      }
    });
  }
</script>
