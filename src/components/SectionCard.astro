---
/**
 * A titled section panel. The home page composes three of these:
 * skills at full width, education and experience side by side.
 */
interface Props {
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
  id?: string;
  class?: string;
}
const { title, description, href, linkLabel, id, class: className } = Astro.props;
---

<section
  id={id}
  class:list={[
    'rounded-2xl border border-edge bg-surface/60 p-5 sm:p-7 backdrop-blur-sm',
    className,
  ]}
>
  <header class="mb-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <div>
      <h2 class="text-xl font-semibold tracking-tight text-zinc-50 sm:text-2xl">
        {title}
      </h2>
      {description && <p class="mt-1 text-sm text-zinc-400">{description}</p>}
    </div>
    {
      href && linkLabel && (
        <a
          href={href}
          class="text-sm font-medium text-accent transition hover:text-zinc-50"
        >
          {linkLabel} <span aria-hidden="true">→</span>
        </a>
      )
    }
  </header>
  <slot />
</section>
